{
  "expo": {
    "name": "Tchope",
    "slug": "tchope",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "tchope",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lndev.tchope",
      "appleTeamId": "JDWTCZR377",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSSpeechRecognitionUsageDescription": "TchopAI Live utilise la reconnaissance vocale pour vous guider pendant la cuisine.",
        "NSMicrophoneUsageDescription": "TchopAI Live utilise le micro pour écouter vos questions pendant la cuisine.",
        "NSCameraUsageDescription": "TchopAI utilise la caméra pour analyser vos plats et ingrédients.",
        "NSPhotoLibraryUsageDescription": "TchopAI accède à votre galerie pour analyser vos photos de plats et ingrédients.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.lndev.tchope.widgets"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lndev.tchope",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "./plugins/with-no-aps-environment.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.revenuecat.** { *; }\n-keep class com.reactnativeandroidwidget.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn com.revenuecat.**\n# WorkManager: classes instanciées par réflexion (Room et InputMerger)\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase { *; }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.impl.** { *; }\n-keep class * extends androidx.work.InputMerger { public <init>(); }"
          }
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "TchopAI accède à votre galerie pour analyser vos photos de plats et ingrédients.",
          "cameraPermission": "TchopAI utilise la caméra pour analyser vos plats et ingrédients."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "./plugins/with-widget-resources",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RecipeOfTheDay",
              "label": "Tchopé · Découverte du jour",
              "description": "Découverte du jour — adapté à votre écran",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/discover.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RecipeOfTheDaySmall",
              "label": "Tchopé · Découverte du jour compact",
              "description": "Découverte du jour — adapté à votre écran",
              "minWidth": "140dp",
              "minHeight": "80dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "previewImage": "./assets/widgets/discover.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PlannerWidget",
              "label": "Tchopé · Planning des repas",
              "description": "Planning des repas — adapté à votre écran",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/agenda.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PlannerWidgetSmall",
              "label": "Tchopé · Planning des repas compact",
              "description": "Planning des repas — adapté à votre écran",
              "minWidth": "140dp",
              "minHeight": "80dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "previewImage": "./assets/widgets/agenda.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RecipeFavorites",
              "label": "Tchopé · Favoris",
              "description": "Favoris — adapté à votre écran",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/favorites.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ShoppingWidget",
              "label": "Tchopé · Liste de courses",
              "description": "Liste de courses — adapté à votre écran",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/shopping.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "KitchenShortcuts",
              "label": "Tchopé · Raccourcis",
              "description": "Raccourcis — adapté à votre écran",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/shortcuts.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TchopAI Live utilise le micro pour écouter vos questions pendant la cuisine.",
          "speechRecognitionPermission": "TchopAI Live utilise la reconnaissance vocale pour vous guider pendant la cuisine."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TchopAI Live utilise le micro pour écouter vos questions pendant la cuisine.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/with-pods-deployment-target",
      "./plugins/with-personalisation",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Plantain",
            "ios": "./assets/app-icons/plantain/icon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/plantain/foreground.png",
              "backgroundImage": "./assets/app-icons/plantain/background.png",
              "backgroundColor": "#F5D681",
              "monochromeImage": "./assets/app-icons/plantain/monochrome.png"
            }
          },
          {
            "name": "Ndole",
            "ios": "./assets/app-icons/ndole/icon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/ndole/foreground.png",
              "backgroundImage": "./assets/app-icons/ndole/background.png",
              "backgroundColor": "#E8EEDC",
              "monochromeImage": "./assets/app-icons/ndole/monochrome.png"
            }
          },
          {
            "name": "Nuit",
            "ios": "./assets/app-icons/nuit/icon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/nuit/foreground.png",
              "backgroundImage": "./assets/app-icons/nuit/background.png",
              "backgroundColor": "#272A23",
              "monochromeImage": "./assets/app-icons/nuit/monochrome.png"
            }
          },
          {
            "name": "Doree",
            "ios": "./assets/app-icons/doree/icon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/doree/foreground.png",
              "backgroundImage": "./assets/app-icons/doree/background.png",
              "backgroundColor": "#30261C",
              "monochromeImage": "./assets/app-icons/doree/monochrome.png"
            }
          },
          {
            "name": "Minimaliste",
            "ios": "./assets/app-icons/minimaliste/icon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/minimaliste/foreground.png",
              "backgroundImage": "./assets/app-icons/minimaliste/background.png",
              "backgroundColor": "#FAF6EF",
              "monochromeImage": "./assets/app-icons/minimaliste/monochrome.png"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aaec700f-9bdc-4162-a589-a215757f7ca4",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.lndev.tchope.recipe-widget",
                  "targetName": "RecipeWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.lndev.tchope.widgets"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
